# OpenAI — survey instrument (gpt-5.5 + web_search) and journal writer
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE

# Upstash Redis — all runtime state (series, evidence log, panel state)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here

# Bearer secret for cron + admin sign-off endpoints (fail-closed: required)
CRON_SECRET=your-cron-secret-here

# FRED — wage denominator AHETPI (falls back to keyless fredgraph.csv if absent)
FRED_API_KEY=your-fred-api-key-here

# BLS Public Data API v2 — CPI context series CUUR0000SEFV02 (register free at
# https://data.bls.gov/registrationEngine/)
BLS_API_KEY=your-bls-api-key-here
